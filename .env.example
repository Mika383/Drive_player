# Local Next.js app. Set the exact origin and add the matching Google OAuth redirect URI.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://drive_player:change-me@localhost:5432/drive_player
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 encoded. Keep old keys until all stored tokens are re-encrypted.
TOKEN_ENCRYPTION_KEY_V1=
# Absolute path outside this repository to the service account JSON file.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
